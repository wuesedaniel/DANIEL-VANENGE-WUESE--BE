//chaining promises with error handling
function fetchDataWithErrorPromise() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            const error = new Error("Failed to fetch data");
            reject(error);
        }, 10000);
    });
}
fetchDataWithErrorPromise()
    .then(data => {
        console.log("Data fetched: ", data);
    })
    .catch(error => {
        console.error("Error fetching data: ", error);
        return "Default data"; // Return default data to continue the chain
    })
    .then(data => {
        console.log("Data after error handling: ", data);
    });

//async/await with error handling
const fetchDataWithErrorAsync = async () => {
    try {        const data = await fetchDataWithErrorPromise();
        console.log("Data fetched with async/await: ", data);
    } catch (error) {
        console.error("Error fetching data with async/await: ", error);
        return "Default data"; // Return default data to continue the chain
    }
};
fetchDataWithErrorAsync()
    .then(data => {
        console.log("Data after error handling with async/await: ", data);
    });
    console.log("This will log before the data fetched with async/await due to asynchronous nature of JavaScript");


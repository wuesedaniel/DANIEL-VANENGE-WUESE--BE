//Difference beween sequential and execution patterns
async function fetchDataSequential() {
    try {
        console.log("Fetching data sequentially...");
        const data1 = await new Promise((resolve) => {
            setTimeout(() => {
                resolve({ id: 1, name: 'John Doe' });
            }, 2000);
        });
        console.log("Data 1 received: ", data1);
        const data2 = await new Promise((resolve) => {
            setTimeout(() => {
                resolve({ id: 2, name: 'Jane Smith' });
            }, 2000);
        });
        console.log("Data 2 received: ", data2);
    } catch (error) {
        console.error("Error fetching data: ", error);
    } finally {
        console.log("Fetch attempt completed.");
    }
}


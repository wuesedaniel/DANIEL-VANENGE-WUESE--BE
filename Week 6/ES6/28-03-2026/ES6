//Map and Set Collections
//Map
const myMap = new Map();
myMap.set('key1', 'value1');
myMap.set('key2', 'value2');
console.log(myMap.get('key1')); // Output: value1
console.log(myMap.has('key2')); // Output: true
myMap.delete('key1');
console.log(myMap.has('key1')); // Output: false
//Set
const mySet = new Set();
mySet.add(1);
mySet.add(2);
mySet.add(2);
console.log(mySet.has(1)); // Output: true
console.log(mySet.has(2)); // Output: true
console.log(mySet.size); // Output: 2
mySet.delete(1);
console.log(mySet.has(1)); // Output: false

//building a phone book using Map
const phoneBook = new Map();
phoneBook.set('Alice', '123-456-7890');
phoneBook.set('Bob', '987-654-3210');
console.log(phoneBook.get('Alice')); // Output: 123-456-7890
console.log(phoneBook.has('Bob')); // Output: true
phoneBook.delete('Alice');
console.log(phoneBook.has('Alice')); // Output: false

//building a unique list of items using Set
const uniqueItems = new Set();
uniqueItems.add('apple');
uniqueItems.add('banana');
uniqueItems.add('apple');
console.log(uniqueItems.size); // Output: 2
console.log(uniqueItems.has('apple')); // Output: true
console.log(uniqueItems.has('banana')); // Output: true
uniqueItems.delete('apple');
console.log(uniqueItems.has('apple')); // Output: false

//removing duplicates from an array using Set
const numbers = [1, 2, 3, 2, 4, 1];
const uniqueNumbers = new Set(numbers);
console.log(uniqueNumbers); // Output: Set { 1, 2, 3, 4 }
const uniqueNumbersArray = Array.from(uniqueNumbers);
console.log(uniqueNumbersArray); // Output: [1, 2, 3, 4]

//finding unique characters in a string using Set
const str = 'hello world';
const uniqueChars = new Set(str);
console.log(uniqueChars); // Output: Set { 'h', 'e', 'l', 'o', ' ', 'w', 'r', 'd' }
const uniqueCharsArray = Array.from(uniqueChars);
console.log(uniqueCharsArray); // Output: ['h', 'e', 'l', 'o', ' ', 'w', 'r', 'd']  

//implementing set operations using Set
const setA = new Set([1, 2, 3]);
const setB = new Set([3, 4, 5]);
//Union
const union = new Set([...setA, ...setB]);
console.log(union); // Output: Set { 1, 2, 3, 4, 5 }
//Intersection
const intersection = new Set([...setA].filter(x => setB.has(x)));
console.log(intersection); // Output: Set { 3 }
//Difference
const difference = new Set([...setA].filter(x => !setB.has(x)));
console.log(difference); // Output: Set { 1, 2 }


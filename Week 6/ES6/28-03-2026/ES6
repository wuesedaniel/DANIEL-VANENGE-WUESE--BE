//Arrow Functions & Context
//Traditional Function
//Function Declaration
function add(a, b) {
    return a + b;
}

//Function Expression
const add = function(a, b) {
    return a + b;
};

//Arrow Function
const add = (a, b) => a + b;
return a + b;
console.log(add(2, 3)); // Output: 5

//Arrow Functions and Context
const person = {
    name: 'Alice',
    greet: function() {
        console.log(`Hello, my name is ${this.name}`);
    }
};
person.greet(); // Output: Hello, my name is Alice

//Using Arrow Function
const person2 = {
    name: 'Alice',
    greet: () => {
        console.log(`Hello, my name is ${this.name}`);
    }
};
person2.greet(); // Output: Hello, my name is undefined

//In the arrow function, 'this' does not refer to the person object, but to the global context, which is why it returns undefined. Arrow functions do not have their own 'this' and instead inherit it from the surrounding scope.
function Person(name) {
    this.name = name;
}
Person.prototype.greet = function() {
    console.log(`Hello, my name is ${this.name}`);
};
const alice = new Person('Alice');
alice.greet(); // Output: Hello, my name is Alice

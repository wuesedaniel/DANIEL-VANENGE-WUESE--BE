//optional chaining
const person = {
    name: 'Alice',
    address: {
        street: '123 Main St',
        city: 'Anytown'
    }
};
console.log(person.address?.street); // Output: 123 Main St
console.log(person.address?.zip); // Output: undefined 
//Nullish Coalescing Operator
const value = null;
const defaultValue = 'Default';
const result = value ?? defaultValue;
console.log(result); // Output: Default

//combining features
const person = {
    name: 'Alice',
    age: 30,
    address: {
        street: '123 Main St',
        city: 'Anytown'
    }
};
const { name, age } = person;
const street = person.address?.street ?? 'Address not available';
console.log(name); // Output: Alice
console.log(age); // Output: 30
console.log(street); // Output: 123 Main St

//In summary, ES6 introduced several modern syntax features that enhance the readability and functionality of JavaScript code. These features include let and const for variable declaration, template literals for string interpolation, destructuring assignment for extracting values from objects and arrays, default parameters for function arguments, the spread operator for combining arrays and objects, optional chaining for safe property access, and the nullish coalescing operator for handling null or undefined values. By utilizing these features, developers can write cleaner and more efficient code in JavaScript.

